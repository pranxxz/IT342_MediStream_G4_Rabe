<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_default"
    app:cardBackgroundColor="@color/pure_white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Consultation Detail"
                android:textColor="@color/brand_primary"
                android:textSize="18sp"
                android:layout_marginBottom="12dp" />

            <!-- Date Chip -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/brand_primary"
                android:layout_marginBottom="20dp">
                <TextView
                    android:id="@+id/tvConsultationDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/pure_white"
                    android:textSize="12sp"
                    tools:text="May 26, 2026 - 02:44 PM" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Patient Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="PATIENT"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:letterSpacing="0.05"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvConsultationPatientName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                tools:text="Juana Dela Cruz (#102)" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_default"
                android:layout_marginBottom="12dp" />

            <!-- Doctor Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="DOCTOR"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:letterSpacing="0.05"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvConsultationDoctorName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                tools:text="Dr. Evan Lee" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_default"
                android:layout_marginBottom="12dp" />

            <!-- Symptoms Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="SYMPTOMS"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:letterSpacing="0.05"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvConsultationSymptoms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                tools:text="Persistent dry cough, mild fever, fatigue for 3 days." />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_default"
                android:layout_marginBottom="12dp" />

            <!-- Diagnosis Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="DIAGNOSIS"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:letterSpacing="0.05"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvConsultationDiagnosis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/brand_accent"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                tools:text="Acute bronchitis." />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_default"
                android:layout_marginBottom="12dp" />

            <!-- Prescription Section (Prescription Pad style) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="PRESCRIPTION"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FAF8F8"
                android:layout_marginBottom="12dp">

                <!-- Left border accent -->
                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="@color/brand_accent" />

                <!-- Prescription Content -->
                <TextView
                    android:id="@+id/tvConsultationPrescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    tools:text="Amoxicillin 500mg, 3x a day for 7 days." />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_default"
                android:layout_marginBottom="12dp" />

            <!-- Remarks Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="REMARKS / FOLLOW-UP"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:letterSpacing="0.05"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvConsultationRemarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginBottom="24dp"
                tools:text="Rest and hydrate. Re-evaluate if symptoms persist." />

            <!-- Close Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseDialog"
                style="@style/MediStream.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Close" />

        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
