<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Timeline indicator elements (kept for adapter compatibility) -->
    <View
        android:id="@+id/timelineLine"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="#DCDCDC"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="9dp" />

    <View
        android:id="@+id/timelineDot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/button_background_maroon"
        android:backgroundTint="@color/brand_primary"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/cardTimeline"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="4dp"
        android:layout_marginTop="20dp" />

    <!-- Details Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTimeline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/border_default"
        app:cardBackgroundColor="@color/pure_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Left Timeline Accent Bar inside Card -->
            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@color/brand_primary" />

            <!-- Main Content Area -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- Top Header Row -->
                <LinearLayout
                    android:id="@+id/headerRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_toStartOf="@+id/ivChevron"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true">

                    <!-- Date Badge -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="#1A3D080B"
                        android:layout_marginEnd="10dp">
                        <TextView
                            android:id="@+id/tvTimelineDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:fontFamily="@font/poppins_semibold"
                            android:textColor="@color/brand_primary"
                            android:textSize="11sp"
                            tools:text="May 12, 2026 - 10:30 AM" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Patient & Doctor Text -->
                <TextView
                    android:id="@+id/tvTimelineDoctor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/headerRow"
                    android:layout_toStartOf="@+id/ivChevron"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    tools:text="Dr. Alice Smith | Patient: John Doe" />

                <!-- Diagnosis Preview -->
                <TextView
                    android:id="@+id/tvTimelineDiagnosis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvTimelineDoctor"
                    android:layout_toStartOf="@+id/ivChevron"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="Diagnosis: Mild influenza." />

                <!-- Chevron Icon Right -->
                <ImageView
                    android:id="@+id/ivChevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_muted"
                    android:contentDescription="View details" />

                <!-- Kept Invisible/Gone but present for Adapter Compatibility -->
                <TextView
                    android:id="@+id/tvTimelineSymptoms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvTimelinePrescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvTimelineRemarks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

            </RelativeLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
