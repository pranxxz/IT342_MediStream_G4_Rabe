<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f0eeee">

    <!-- ===== Maroon Header (rounded bottom corners) ===== -->
    <LinearLayout
        android:id="@+id/headerBanner"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/bg_header_rounded_bottom"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="40dp"
        android:paddingBottom="32dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MediStream"
            android:textColor="#ffffff"
            android:textSize="32sp"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Streamlined Healthcare"
            android:textColor="#cc8899"
            android:textSize="14sp"
            android:fontFamily="sans-serif" />

    </LinearLayout>

    <!-- ===== Scrollable Body ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:fillViewport="true"
        android:background="#f0eeee"
        app:layout_constraintTop_toBottomOf="@id/headerBanner"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="28dp"
            android:paddingTop="36dp"
            android:paddingBottom="40dp">

            <!-- Page Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create an Account"
                android:textColor="#44000d"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black"
                android:layout_marginBottom="28dp" />

            <!-- First Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFirstName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="First Name"
                android:layout_marginBottom="14dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxStrokeColor="#44000d"
                app:boxStrokeWidth="1.5dp"
                app:boxBackgroundColor="#ffffff"
                app:hintTextColor="#44000d"
                app:startIconDrawable="@drawable/ic_email"
                app:startIconTint="#44000d">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter your first name"
                    android:inputType="textPersonName"
                    android:textColor="#212529"
                    android:textColorHint="#adb5bd"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Last Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLastName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Last Name"
                android:layout_marginBottom="14dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxStrokeColor="#44000d"
                app:boxStrokeWidth="1.5dp"
                app:boxBackgroundColor="#ffffff"
                app:hintTextColor="#44000d"
                app:startIconDrawable="@drawable/ic_email"
                app:startIconTint="#44000d">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegLastName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter your last name"
                    android:inputType="textPersonName"
                    android:textColor="#212529"
                    android:textColorHint="#adb5bd"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Email -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email"
                android:layout_marginBottom="14dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxStrokeColor="#44000d"
                app:boxStrokeWidth="1.5dp"
                app:boxBackgroundColor="#ffffff"
                app:hintTextColor="#44000d"
                app:startIconDrawable="@drawable/ic_email"
                app:startIconTint="#44000d">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter email"
                    android:inputType="textEmailAddress"
                    android:textColor="#212529"
                    android:textColorHint="#adb5bd"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ID Number -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStaffId"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ID Number"
                android:layout_marginBottom="14dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxStrokeColor="#44000d"
                app:boxStrokeWidth="1.5dp"
                app:boxBackgroundColor="#ffffff"
                app:hintTextColor="#44000d"
                app:startIconDrawable="@drawable/ic_email"
                app:startIconTint="#44000d">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegStaffId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter you ID number"
                    android:inputType="number"
                    android:textColor="#212529"
                    android:textColorHint="#adb5bd"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"
                android:layout_marginBottom="14dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxStrokeColor="#44000d"
                app:boxStrokeWidth="1.5dp"
                app:boxBackgroundColor="#ffffff"
                app:hintTextColor="#44000d"
                app:startIconDrawable="@drawable/ic_email"
                app:startIconTint="#44000d"
                app:endIconMode="password_toggle"
                app:endIconTint="#44000d">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter your password"
                    android:inputType="textPassword"
                    android:textColor="#212529"
                    android:textColorHint="#adb5bd"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Confirm Password -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfirmPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Confirm Password"
                android:layout_marginBottom="36dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxStrokeColor="#44000d"
                app:boxStrokeWidth="1.5dp"
                app:boxBackgroundColor="#ffffff"
                app:hintTextColor="#44000d"
                app:startIconDrawable="@drawable/ic_email"
                app:startIconTint="#44000d"
                app:endIconMode="password_toggle"
                app:endIconTint="#44000d">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Re-enter your password"
                    android:inputType="textPassword"
                    android:textColor="#212529"
                    android:textColorHint="#adb5bd"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:visibility="gone"
                android:indeterminateTint="#44000d"
                android:layout_marginBottom="12dp" />

            <!-- Sign Up Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                android:layout_width="180dp"
                android:layout_height="52dp"
                android:text="Sign up"
                android:textColor="#ffffff"
                android:textSize="15sp"
                android:fontFamily="sans-serif-black"
                android:textAllCaps="false"
                android:background="@drawable/bg_button_maroon_rounded"
                android:layout_marginBottom="20dp"
                app:backgroundTint="@null"
                app:cornerRadius="26dp" />

            <!-- Already have an account -->
            <TextView
                android:id="@+id/tvToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? Sign in"
                android:textColor="#6c757d"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:textStyle="italic"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>